[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/share/fonts/*

[Action]
Description = Replacing glyph in noto-fonts-emoji...
When = PostTransaction
Exec = /usr/bin/ttf-replace-glyph /usr/share/fonts/noto/NotoColorEmoji.ttf /usr/share/fonts/noto-emoji-bel/glyph01574_s0.png
